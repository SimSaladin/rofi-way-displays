#!/usr/bin/env bash

set -euo pipefail

#set -x

PROGRAM_NAME="rofi-way-displays"
PROGRAM_VERSION="0.0.1"

# Options that can be set through way-displays
declare -A opts=(
    [ARRANGE_ALIGN]=' "ROW|COLUMN" "TOP|MIDDLE|BOTTOM|LEFT|RIGHT" '
    # Enable scaling: NOTE: overrides AUTO_SCALE and SCALE
    [SCALING]='       "on|off"'
    [AUTO_SCALE]='    "on|off"'
    [ORDER]='         "!NAME|!REGEX|=END"'
    [SCALE]='         "!NAME" "!SCALE"'
    # Specified resolution at its highest refresh.
    # Optional refresh will choose a mode +-0.5Hz.
    [MODE]='          "!NAME" "!width|MAX" "!height" "!hz"'
    [TRANSFORM]='     "!NAME"'
    [VRR_OFF]='       "!NAME"'
    [DISABLED]='      "!NAME"'
)
opts[TRANSFORM]+=' "90|180|270|flipped|flipped-90|flipped-180|flipped-270"'
orderpart=" ${opts[ORDER]}"

# The ORDER is special, it takes as many arguments as there are displays
# /at most/.
for _ in 1 2 3 4 5 6 7; do
    opts[ORDER]+="$orderpart"
done

# Options that are toggleable (-t).
declare -A toggles=(
    [SCALING]=''
    [AUTO_SCALE]=''
    [DISABLED]='"!NAME"'
    [VRR_OFF]='"!NAME"'
)

# Options that are deletable (-d).
declare -A deletes=(
    [SCALE]='"!NAME"'
    [MODE]='"!NAME"'
    [TRANSFORM]='"!NAME"'
    [DISABLED]='"!NAME"'
    [VRR_OFF]='"!NAME"'
    [CALLBACK_CMD]='"!NAME"'
)

# Set this non-null to force the built way-displays command to be executed.
commandEndNow=${commandEndNow-}

# way-displays executable wrapper.
__way-displays() {
    echo "debug: calling way-displays with: ${*@Q}" >&2
    if way-displays "$@" 2>/dev/null; then
        :
    else
        ret=$?
        echo "warning: way-displays returned a non-zero exit code: $ret!" >&2
        return $ret
    fi
}

_cachedGet=

cachedWayDisplaysGet() {
    if [[ -z ${_cachedGet-} ]]; then
        _cachedGet=$(__way-displays -y -g)
    fi
    cat <<<"$_cachedGet"
}

# Write a row with attributes:
#
#   display_opt value infovalue [key value[ key value [key value[ ... ]]]]
display_opt () {
    printf "%s\0%s\x1f%s" "$1" info "$2"
    shift 2
    while [[ $# -gt 0 ]]; do
        printf "\x1f%s\x1f%s" "$1" "$2"
        shift 2
    done
    printf "\n"
}

# Rofi prompt options set
rofiset(){
    printf "\0%s\x1f%s\n" "$@"
}

# Get the current values of various way-displays settings.
displays_get_current () {
    yq -r '.CFG |
        "ARRANGE_ALIGN \(.ARRANGE) \(.ALIGN)",
        (to_entries[] |
            "\(.key) \(.value|if type == "array" then
                . | map(strings) | join(" ") else . end)")'
        #(.SCALE[] | "SCALE \(.NAME_DESC) \(.SCALE)"),
}

# Display current configuration values. Filtered to show only values that are
# being viewed in the current prompt.
# TODO customizable current value output format.
show_current_config () {
    echo "debug: showing current..." >&2
    displays_get_current | \
        while read -r key xs; do
            [[ $key == "$1" ]] || continue
            display_opt "$key $xs (current value)" "$key" \
                nonselectable true \
                active true \
                permanent true
        done
}

# Enabled iff "$1 == true"
isenabledPP() {
    if [[ "$1" == true ]]; then
        colorSpan "#719e07" "${2-"[enabled]"}"
    else
        colorSpan "#6c71c4" "${3-"[disabled]"}"
    fi
}

colorSpan () {
    printf "<span color='%s'>%s</span>" "$1" "$2"
}

# Resolve the names of available displays (for !NAME arguments).
# TODO more structured output?
display_name_opts () {
    echo "debug: getting display names..." >&2
    yq -r '.STATE.HEADS[] |
        "\(.NAME) " +
        "\(.CURRENT.ENABLED) " +
        "\(.CURRENT.SCALE) " +
        "\(.CURRENT.VRR) " +
        "\(.CURRENT |
            "\(.MODE.WIDTH)x\(.MODE.HEIGHT)" +
            "+\(.X)-\(.Y)" +
            "@\(.MODE.REFRESH_MHZ/1000)"
        ) " +
        "\(.DESCRIPTION))"
        ' \
        | while read -r \
                name enabled scale vrr \
                sizepos description
        do
            display_opt "$(printf "%s <b>%-10s</b> [%2.3f] %-30s %s %s" \
                "$(isenabledPP "$enabled")" \
                "$name" \
                "${scale//./,}" \
                "$sizepos" \
                "<i>$(isenabledPP "$vrr" " VRR " "NOVRR")</i>" \
                "$description" \
                )" \
                "$name"
                #active "$enabled"
        done
}

# Expand command options. That is, options defined by the "$opts", "$toggles",
# "$deletes" values.
expand_opts () {
    local str=$1 this next
    while [[ -n $str ]]; do
        this=${str%%'|'*}
        next=${str#*'|'}
        case $this in
            ''     ) break ;;
            '!NAME') display_name_opts  ;;
            '!'*   ) display_opt "$this" "$this" nonselectable "true" ;;
            *      ) display_opt "$this" "$this" ;;
        esac
        [[ $this != "$next" ]] || break
        str=$next
    done
}

# Produce the current prompt action and/or output.
waydisplays_get_options () {
    local OPERATION=${1-}
    case $#,$OPERATION in

        # In the beginning, the selected command is empty.
        0, | 1,*)
            local k
            rofiset message '' data ''
            for k in "${!opts[@]}"; do
                display_opt "$(colorSpan \
                    "#268bd2" \
                    '<b>[SET]</b>')"$'\t'"$k"$'\t'"${opts["$k"]//  / }" \
                    "--set $k"
            done
            for k in "${!toggles[@]}"; do
                display_opt "$(colorSpan \
                    "#719e07" \
                    '<b>[TAP]</b>')"$'\t'"$k"$'\t'"${toggles["$k"]}" \
                    "--toggle $k"
            done
            for k in "${!deletes[@]}"; do
                display_opt "$(colorSpan \
                    "#dc322f" \
                    '<b>[DEL]</b>')"$'\t'"$k"$'\t'"${deletes["$k"]}" \
                    "--delete $k"
            done
            ;;

        # When at leat one command paramater has been chosen...
        *,--* )
            local pos
            pos=$(($#-1))
            local -a args=("$@")
            rofiset data "${*@Q}" message "way-displays $*"
            case $OPERATION in
                --set   ) eval set -- "${opts["$2"]}"    ;;
                --toggle) eval set -- "${toggles["$2"]}" ;;
                --delete) eval set -- "${deletes["$2"]}" ;;
                *       ) echo "error: unexpected value: $OPERATION" >&2 ;;
            esac

            # Execute the way-displays command now?
            if [[ $pos -gt $# || -n $commandEndNow ]]; then
                local output
                echo "debug: ready to run: way-displays ${args[*]@Q}" >&2
                rofiset message "ready: way-displays ${args[*]}"
                if output=$(way-displays "${args[@]}" 2>/dev/null \
                    | tr '\n' ' '); then
                    echo -e "Success!" >&2
                else
                    echo -e "the command failed!" >&2
                fi
                sleep 0.4
                display_opt "Run again: ${args[*]}" "" urgent true
                display_opt "Result: $output" "" \
                    nonselectable true permanent true
            fi

            local curcfg
            curcfg=$(cachedWayDisplaysGet)

            if ! [[ $pos -gt $# || -n $commandEndNow ]]; then
                # When not executing command, expand the next argument instead:
                shift $((pos-1))
                expand_opts "$1" <<<"$curcfg"
            fi

            # Always show any relevant current config values. NOTE: this
            # should only be run after any way-displays calls to change
            # settings above, so that the cturrent state is reflected in the
            # output!
            show_current_config <<<"$curcfg" "${args[1]}"
    esac

    display_opt "$(colorSpan "green" "Go back")" --back
    display_opt "$(colorSpan "red" "Reset (back to start)")" --reset
    display_opt "$(colorSpan "red" "Quit")" --quit
}

# If not running inside rofi, launch ourselves.
relaunch_via_rofi() {
    echo "warning: seemingly not running via rofi!" >&2
    SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
    SCRIPT_NAME=$(basename "$0")
    echo "Attempting to launch self (-show $SCRIPT_DIR/$SCRIPT_NAME).." >&2
    exec rofi -show "way-displays:$SCRIPT_DIR/$SCRIPT_NAME"
}

usage() {
    cat <<__END__
Usage: $0 [options...]
       rofi -show way-displays:$(realpath --relative-base="$PWD" "$0")

  -h   --help          Show this usage summary and exit
  -V   --version       Print version information
       --list-names    Lists the display names and properties
       --list-current  Lisst current values for various options

This script is intended to be used through the rofi-script
interface. Listed options are not available in rofi-script mode.
__END__
}

printVersionAndExit() {
    echo "$PROGRAM_NAME $PROGRAM_VERSION"
    exit
}

rofiPromptHandler() {
    case $ROFI_RETV in
        0)
            # On first prompt setup the prompt settings. Then display the initial
            # output.
            echo "debug: initial begin..." >&2
            rofiset prompt way-displays markup-rows true
            waydisplays_get_options
            ;;
        1)
            # This branch is entered when a presented option was chosen from the
            # list of options.
            echo "entry selected: ${ROFI_DATA-} $ROFI_INPUT ${ROFI_INFO-}" >&2
            if [[ ${ROFI_INFO-} == "--back" || ${ROFI_INFO-} == "=END" ]]; then
                eval set -- "${ROFI_DATA-}"
                set -- "${@:1:$#-1}"
                if [[ ${ROFI_INFO-} == "=END" ]]; then
                    commandEndNow=1
                fi
            elif [[ ${ROFI_INFO-} == "--quit" ]]; then
                exit 0
            elif [[ ${ROFI_INFO-} == "--reset" ]]; then
                set --
            else
                eval set -- "${ROFI_DATA-}${ROFI_DATA+ }${ROFI_INFO-}"
            fi
            waydisplays_get_options "$@"
            ;;
        2)
            # For custom options.
            echo "custom selected: ${ROFI_DATA-} $ROFI_INPUT ${ROFI_INFO-}" >&2
            info="${ROFI_DATA-}${ROFI_DATA+ }${ROFI_INPUT}"
            eval set -- "$info"
            waydisplays_get_options "$@"
            ;;
        3)
            # This should not be reached normally ever in this script.
            echo "deleted entry" >&2
            ;;
        *)
            # Custom key bindings would be handled here.
            echo "Other command!" >&2
            ;;
    esac
}

# Type quit to exit the prompts right away.
if [[ "$*" == "quit" ]]; then
    exit 0
fi

# Handle rofi script loop when present...
if [[ -v ROFI_RETV ]]; then
    rofiPromptHandler "$@"
    exit
fi

# Fallback to parsing options. Might relaunch tie script via rofi below!
TEMP=$(getopt -n "$0" \
    --options "hv" \
    --longoptions "version,help,list-names,list-current" \
    -- "$@") || exit $?
eval set -- "$TEMP"
unset TEMP

defaultActionEnable=1

while :; do
    case $1 in
        --version|-V ) printVersionAndExit ;;
        --help|-h) usage; exit ;;
        --list-current)
            cachedWayDisplaysGet | displays_get_current | tr $'\\0\x1f' '|/'
            defaultActionEnable=
            shift
            ;;
        --list-names)
            cachedWayDisplaysGet | display_name_opts | tr $'\\0\x1f' '|/'
            defaultActionEnable=
            shift
            ;;
        --) shift; break ;;
        * ) echo 'Internal error' >&2; exit 1 ;;
    esac
done

# The default action is to launch the script through rofi for prompts.
if [[ -n $defaultActionEnable ]]; then
    relaunch_via_rofi
fi
